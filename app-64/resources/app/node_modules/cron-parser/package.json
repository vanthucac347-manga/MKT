{
  "name": "cron-parser",
  "version": "4.9.0",
  "description": "Node.js library for parsing crontab instructions",
  "main": "lib/parser.js",
  "types": "types/index.d.ts",
  "typesVersions": {
    "<4.1": {
      "*": [
        "types/ts3/*"
      ]
    }
  },
  "directories": {
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/harrisiirak/cron-parser.git"
  },
  "author": "Harri Siirak",
  "license": "MIT",
  "dependencies": {
    "luxon": "^3.2.1"
  },
  "devDependencies": {
    "eslint": "^8.27.0",
    "sinon": "^15.0.1",
    "tap": "^16.3.3",
    "tsd": "^0.26.0"
  },
  "engines": {
    "node": ">=12.0.0"
  },
  "browser": {
    "fs": false
  },
  "tap": {
    "check-coverage": false
  },
  "tsd": {
    "directory": "test",
    "compilerOptions": {
      "lib": [
        "es2017",
        "dom"
      ]
    }
  },
  "files": [
    "lib",
    "types",
    "LICENSE",
    "README.md"
  ]
}