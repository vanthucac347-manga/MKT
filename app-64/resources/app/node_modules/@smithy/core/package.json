    "directory": "packages/core"
  },
  "devDependencies": {
    "@smithy/eventstream-serde-node": "^4.2.3",
    "@types/node": "^18.11.9",
    "concurrently": "7.0.0",
    "downlevel-dts": "0.10.1",
    "json-bigint": "^1.0.0",
    "rimraf": "3.0.2",
    "typedoc": "0.23.23"
  },
  "typedoc": {
    "entryPoint": "src/index.ts"
  },
  "publishConfig": {
    "directory": ".release/package"
  }
}